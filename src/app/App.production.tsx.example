// Production version with FULL FEATURES enabled
// To use: Rename this file to App.tsx before deploying to Vercel

import { useState, useTransition, startTransition, lazy, Suspense } from 'react';
import { Hand, ScanFace, Info } from 'lucide-react';
import { ErrorBoundary } from './components/ErrorBoundary';

// Lazy load heavy components for production
const HandTracking = lazy(() =>
  import('./components/HandTracking').then(m => ({ default: m.HandTracking }))
);

const FaceTracking = lazy(() =>
  import('./components/FaceTracking').then(m => ({ default: m.FaceTracking }))
);

function LoadingSpinner() {
  return (
    <div className="size-full flex items-center justify-center bg-black">
      <div className="text-white text-center">
        <div className="animate-spin rounded-full h-16 w-16 border-b-2 border-white mx-auto mb-4"></div>
        <p className="text-xl">Loading tracking module...</p>
        <p className="text-sm text-white/60 mt-2">Downloading AI models (~10-20MB)</p>
      </div>
    </div>
  );
}

export default function App() {
  const [mode, setMode] = useState<'home' | 'hand' | 'face'>('home');
  const [isPending, startTransitionHook] = useTransition();

  // Handle mode changes with transition to avoid Suspense errors
  const handleModeChange = (newMode: 'home' | 'hand' | 'face') => {
    startTransition(() => {
      setMode(newMode);
    });
  };

  if (mode === 'hand') {
    return (
      <div className="size-full flex flex-col">
        <header className="bg-gradient-to-r from-purple-600 to-blue-600 p-4 shadow-lg">
          <div className="flex items-center justify-between max-w-7xl mx-auto">
            <h1 className="text-white text-2xl font-bold flex items-center gap-2">
              <Hand className="w-6 h-6" />
              Hand Tracking
            </h1>
            <button
              onClick={() => handleModeChange('home')}
              className="px-4 py-2 bg-white text-purple-600 rounded-lg font-semibold hover:bg-purple-50 transition-colors"
            >
              Back to Home
            </button>
          </div>
        </header>
        <div className="flex-1">
          <ErrorBoundary>
            <Suspense fallback={<LoadingSpinner />}>
              <HandTracking />
            </Suspense>
          </ErrorBoundary>
        </div>
      </div>
    );
  }

  if (mode === 'face') {
    return (
      <div className="size-full flex flex-col">
        <header className="bg-gradient-to-r from-pink-600 to-purple-600 p-4 shadow-lg">
          <div className="flex items-center justify-between max-w-7xl mx-auto">
            <h1 className="text-white text-2xl font-bold flex items-center gap-2">
              <ScanFace className="w-6 h-6" />
              Face Tracking 3D
            </h1>
            <button
              onClick={() => handleModeChange('home')}
              className="px-4 py-2 bg-white text-pink-600 rounded-lg font-semibold hover:bg-pink-50 transition-colors"
            >
              Back to Home
            </button>
          </div>
        </header>
        <div className="flex-1">
          <ErrorBoundary>
            <Suspense fallback={<LoadingSpinner />}>
              <FaceTracking />
            </Suspense>
          </ErrorBoundary>
        </div>
      </div>
    );
  }

  return (
    <div className="size-full bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex items-center justify-center p-8">
      <div className="max-w-6xl w-full">
        {/* Hero Section */}
        <div className="text-center mb-12">
          <h1 className="text-6xl font-bold text-white mb-4 bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-pink-400">
            AI Vision Tracking
          </h1>
          <p className="text-xl text-purple-200">
            Real-time Hand & Face Tracking with 3D Visualization
          </p>
          <div className="mt-6 flex items-center justify-center gap-2 text-purple-300">
            <Info className="w-5 h-5" />
            <p className="text-sm">
              Powered by MediaPipe & Three.js • Camera access required
            </p>
          </div>
        </div>

        {/* Feature Cards */}
        <div className="grid md:grid-cols-2 gap-8">
          {/* Hand Tracking Card */}
          <div
            onClick={() => handleModeChange('hand')}
            className="group bg-gradient-to-br from-purple-500/20 to-blue-500/20 backdrop-blur-sm border border-purple-500/30 rounded-2xl p-8 cursor-pointer hover:scale-105 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/50"
          >
            <div className="flex items-center justify-center mb-6">
              <div className="p-6 bg-purple-500/30 rounded-full group-hover:bg-purple-500/50 transition-colors">
                <Hand className="w-16 h-16 text-purple-300" />
              </div>
            </div>
            <h2 className="text-3xl font-bold text-white mb-4 text-center">
              Hand Tracking
            </h2>
            <ul className="space-y-3 text-purple-200">
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>Track up to 2 hands simultaneously</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>21 landmarks per hand in real-time</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>Visual feedback with connections</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>High-accuracy gesture recognition</span>
              </li>
            </ul>
            <div className="mt-8 text-center">
              <button className="px-8 py-3 bg-purple-500 text-white rounded-lg font-semibold hover:bg-purple-600 transition-colors">
                Launch Hand Tracking
              </button>
            </div>
          </div>

          {/* Face Tracking Card */}
          <div
            onClick={() => handleModeChange('face')}
            className="group bg-gradient-to-br from-pink-500/20 to-purple-500/20 backdrop-blur-sm border border-pink-500/30 rounded-2xl p-8 cursor-pointer hover:scale-105 transition-all duration-300 hover:shadow-2xl hover:shadow-pink-500/50"
          >
            <div className="flex items-center justify-center mb-6">
              <div className="p-6 bg-pink-500/30 rounded-full group-hover:bg-pink-500/50 transition-colors">
                <ScanFace className="w-16 h-16 text-pink-300" />
              </div>
            </div>
            <h2 className="text-3xl font-bold text-white mb-4 text-center">
              Face Tracking 3D
            </h2>
            <ul className="space-y-3 text-pink-200">
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>468 facial landmarks detection</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>Real-time 3D mesh visualization</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>Interactive 3D view with controls</span>
              </li>
              <li className="flex items-start gap-2">
                <span className="text-green-400 mt-1">✓</span>
                <span>Split view: camera + 3D model</span>
              </li>
            </ul>
            <div className="mt-8 text-center">
              <button className="px-8 py-3 bg-pink-500 text-white rounded-lg font-semibold hover:bg-pink-600 transition-colors">
                Launch Face Tracking
              </button>
            </div>
          </div>
        </div>

        {/* Info Footer */}
        <div className="mt-12 text-center text-purple-300 text-sm">
          <p>
            This application uses your device camera for real-time AI-powered tracking.
          </p>
          <p className="mt-2">
            All processing happens locally in your browser. No data is sent to any server.
          </p>
        </div>
      </div>
    </div>
  );
}
